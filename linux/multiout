def daemon() -> int:
    """Headless auto-switch: no window, no Qt event loop. Watches PipeWire and
    hands audio to a Bluetooth device as soon as one shows up."""
    lock = open(f"{RUNTIME}/multiout-daemon.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("multiout: auto-switch daemon already running", file=sys.stderr)
        return 0

    combine = CombineManager()
    combine.adopt()
    auto = AutoSwitch(combine)
    auto.prime(scan())
    print("multiout: auto-switch daemon watching for Bluetooth outputs",
          flush=True)

    while True:
        try:
            proc = subprocess.Popen(
                ["pactl", "subscribe"], stdout=subprocess.PIPE, text=True,
                stderr=subprocess.DEVNULL)
        except OSError:
            time.sleep(5)
            continue

        pending = 0.0
        try:
            assert proc.stdout
            while proc.poll() is None:
                ready, _, _ = select.select(
                    [proc.stdout], [], [], DEBOUNCE if pending else None)
                if ready:
                    line = proc.stdout.readline()
                    if not line:
                        break
                    if ("on sink " in line or "on card " in line
                            or "on server" in line):
                        pending = time.monotonic()
                    continue
                if pending and time.monotonic() - pending >= DEBOUNCE:
                    pending = 0.0
                    st = load_state()
                    inv = scan()
                    if st.get("autoswitch", True):
                        msg = auto.reconcile(inv, bool(st.get("compensate")))
                        if msg:
                            print(f"multiout: {msg}", flush=True)
                    else:
                        auto.prime(inv)
        finally:
            if proc.poll() is None:
                proc.terminate()

        # PipeWire restarted or the socket went away: resync and reattach.
        time.sleep(2)
        combine.adopt()
        auto.prime(scan())


def main() -> int:
    for tool in ("pactl", "pipewire", "bluetoothctl"):
        if not shutil.which(tool):
            print(f"multiout: required tool not found: {tool}", file=sys.stderr)
            return 1

    if "--daemon" in sys.argv[1:]:
        return daemon()

    app = QApplication(sys.argv)
    app.setApplicationName("Multi-Out")
    app.setDesktopFileName("multiout")
    win = MainWindow()
    win.show()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
