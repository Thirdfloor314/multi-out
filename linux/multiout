RUNTIME = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
STATE = os.path.expanduser("~/.local/share/multiout/state.json")
SERVICE = "multiout-autoswitch.service"

# Quiet period after a topology event before we act, so a device that registers
# its card, sink and ports in quick succession is handled once, not three times.
DEBOUNCE = 0.8


# ---------------------------------------------------------------- state file

def load_state() -> dict:
    try:
        with open(STATE) as fh:
            d = json.load(fh)
        if isinstance(d, dict):
            return d
    except (OSError, ValueError):
        pass
    return {}


def save_state(**changes) -> None:
    """Merge keys into the state file. The GUI and the daemon both write here,
    so this must never rewrite the whole document from one side's view."""
    d = load_state()
    d.update(changes)
    try:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        tmp = f"{STATE}.tmp"
        with open(tmp, "w") as fh:
            json.dump(d, fh)
        os.replace(tmp, STATE)
    except OSError:
        pass


def daemon_running() -> bool:
    """True when the systemd auto-switch service owns the switching."""
    try:
        return subprocess.run(
            ["systemctl", "--user", "is-active", "--quiet", SERVICE],
            capture_output=True, timeout=3).returncode == 0
    except (subprocess.SubprocessError, OSError):
        return False


# ---------------------------------------------------------------- shell helpers

def run(cmd: list[str], timeout: float = 5.0) -> str:
    """Run a command, return stdout, empty string on any failure."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.stdout if p.returncode == 0 else ""
    except (subprocess.SubprocessError, OSError):
        return ""


def run_json(cmd: list[str], timeout: float = 5.0):
    out = run(cmd, timeout)
    if not out.strip():
        return []
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return []


# ---------------------------------------------------------------- data model

@dataclass
class Sink:
    index: int
    name: str
    description: str
    kind: str           # bluetooth | wired | hdmi | virtual
    volume: int         # 0-150 percent
    muted: bool
    mac: str = ""
    battery: int | None = None

    @property
    def is_ours(self) -> bool:
        return self.name.startswith("multiout_")


@dataclass
class BtDevice:
    mac: str
    name: str
    connected: bool
    battery: int | None = None


@dataclass
class Inventory:
    sinks: list[Sink] = field(default_factory=list)
    bt_offline: list[BtDevice] = field(default_factory=list)
    default_sink: str = ""


def classify(name: str) -> str:
    if name.startswith("bluez_output"):
        return "bluetooth"
    if name.startswith("multiout_"):
        return "virtual"
    low = name.lower()
    if "hdmi" in low or "displayport" in low:
        return "hdmi"
    if name.startswith("alsa_output"):
        return "wired"
    return "virtual"


def bt_info(mac: str) -> tuple[str, bool, int | None]:
    """Return (name, connected, battery%) for a paired Bluetooth device."""
    txt = run(["bluetoothctl", "info", mac])
    name, connected, battery = mac, False, None
    for line in txt.splitlines():
        line = line.strip()
        if line.startswith("Alias:"):
            name = line.split(":", 1)[1].strip()
        elif line.startswith("Connected:"):
            connected = line.split(":", 1)[1].strip() == "yes"
        elif line.startswith("Battery Percentage:"):
            # e.g. "Battery Percentage: 0x50 (80)"
            if "(" in line and ")" in line:
                try:
                    battery = int(line.rsplit("(", 1)[1].rstrip(")"))
                except ValueError:
                    pass
    return name, connected, battery


def scan() -> Inventory:
    inv = Inventory()
    inv.default_sink = run(["pactl", "get-default-sink"]).strip()

    # Paired Bluetooth devices, so we can show ones that aren't connected yet.
    paired: dict[str, BtDevice] = {}
    for line in run(["bluetoothctl", "devices", "Paired"]).splitlines():
        parts = line.split(maxsplit=2)
        if len(parts) >= 2 and parts[0] == "Device":
            mac = parts[1]
            nm, conn, batt = bt_info(mac)
            paired[mac.replace(":", "_")] = BtDevice(mac, nm, conn, batt)

    for s in run_json(["pactl", "-f", "json", "list", "sinks"]):
        try:
            name = s["name"]
            vol = s.get("volume", {})
            first = next(iter(vol.values())) if vol else {}
            pct = int(str(first.get("value_percent", "100%")).rstrip("%"))
            sink = Sink(
                index=int(s["index"]),
                name=name,
                description=s.get("description") or name,
                kind=classify(name),
                volume=pct,
                muted=bool(s.get("mute", False)),
            )
        except (KeyError, StopIteration, ValueError, TypeError):
            continue

        if sink.kind == "bluetooth":
            key = sink.name.removeprefix("bluez_output.").rsplit(".", 1)[0]
            dev = paired.get(key)
            if dev:
                sink.mac = dev.mac
                sink.battery = dev.battery
                paired.pop(key, None)
        inv.sinks.append(sink)

    # Audio-capable paired devices with no sink = connectable but offline.
    for key, dev in paired.items():
        cls = run(["bluetoothctl", "info", dev.mac])
        if "Audio Sink" in cls:
            inv.bt_offline.append(dev)

    order = {"bluetooth": 0, "wired": 1, "hdmi": 2, "virtual": 3}
    inv.sinks.sort(key=lambda s: (order.get(s.kind, 9), s.description.lower()))
    return inv


# ---------------------------------------------------------------- combine sink

class CombineManager:
    """Owns the standalone PipeWire process hosting our combine-stream module."""

    def __init__(self) -> None:
        self.pid: int | None = None
        self.node: str = ""
        self.counter = 0

    # -- adoption -----------------------------------------------------------
    @staticmethod
    def find_running() -> list[tuple[str, int]]:
        """Existing (node, pid) combine hosts, from a previous run of this app."""
        found = []
        out = run(["pgrep", "-af", "pipewire -c .*/multiout-.*\\.conf"])
        for line in out.splitlines():
            pid_s, _, cmd = line.partition(" ")
            m = re.search(r"multiout-(multiout_[0-9]+_[0-9]+)\.conf", cmd)
            if m and pid_s.isdigit():
                found.append((m.group(1), int(pid_s)))
        return found

    def adopt(self) -> None:
        """Take ownership of a still-running combine sink instead of rebuilding
        it, so reopening the app never interrupts audio. Extras are reaped."""
        live = {s.get("name") for s in run_json(
            ["pactl", "-f", "json", "list", "sinks"])}
        hosts = [(n, pid) for n, pid in self.find_running() if n in live]
        for node, pid in hosts[1:]:
            self._kill_pid(pid)
        for node, pid in self.find_running():
            if node not in live:
                self._kill_pid(pid)     # process alive but sink gone: stale
        if hosts:
            self.node, self.pid = hosts[0]

    @staticmethod
    def _reap_files() -> None:
        """Delete conf/log files left by combine hosts that are no longer
        running. The daemon rebuilds far more often than the window did, so
        these would otherwise pile up in the runtime dir all session."""
        live = {n for n, _ in CombineManager.find_running()}
        for path in (glob.glob(f"{RUNTIME}/multiout-*.conf")
                     + glob.glob(f"{RUNTIME}/multiout-*.log")):
            m = re.search(r"multiout-(multiout_\d+_\d+)\.(?:conf|log)$", path)
            if m and m.group(1) not in live:
                try:
                    os.remove(path)
                except OSError:
                    pass

    @staticmethod
    def _kill_pid(pid: int) -> None:
        try:
            os.killpg(os.getpgid(pid), signal.SIGTERM)
        except (ProcessLookupError, PermissionError, OSError):
            try:
                os.kill(pid, signal.SIGTERM)
            except OSError:
                pass

    # -- config -------------------------------------------------------------
    def _write_conf(self, node: str, targets: list[str], compensate: bool) -> str:
        match = " ".join(
            '{ media.class = Audio/Sink node.name = "%s" }' % t for t in targets
        )
        conf = f"""
# Standalone module host: connects to the running PipeWire daemon as a client,
# so it loads the same base modules client.conf does before combine-stream.
context.properties = {{ log.level = 2 }}
context.spa-libs = {{
  audio.convert.* = audioconvert/libspa-audioconvert
  support.*       = support/libspa-support
}}
context.modules = [
  {{ name = libpipewire-module-rt              flags = [ ifexists nofail ] }}
  {{ name = libpipewire-module-protocol-native }}
  {{ name = libpipewire-module-client-node     }}
  {{ name = libpipewire-module-adapter         }}
  {{ name = libpipewire-module-metadata        }}
  {{ name = libpipewire-module-combine-stream
    args = {{
      combine.mode = sink
      node.name    = "{node}"
      node.description = "Multi-Out"
      combine.latency-compensate = {"true" if compensate else "false"}
      combine.props = {{ audio.position = [ FL FR ] }}
      stream.props  = {{}}
      stream.rules = [
        {{ matches = [ {match} ]
          actions = {{ create-stream = {{ audio.position = [ FL FR ] }} }} }}
      ]
    }}
  }}
]
"""
        path = f"{RUNTIME}/multiout-{node}.conf"
        with open(path, "w") as fh:
            fh.write(conf)
        return path

    # -- lifecycle ----------------------------------------------------------
    def spawn(self, targets: list[str], compensate: bool) -> str | None:
        """Start a new combine sink. Returns its node name, or None on failure."""
        self._reap_files()
        self.counter += 1
        node = f"multiout_{os.getpid()}_{self.counter}"
        path = self._write_conf(node, targets, compensate)
        log = open(f"{RUNTIME}/multiout-{node}.log", "w")
        try:
            proc = subprocess.Popen(
                ["pipewire", "-c", path], stdout=log, stderr=subprocess.STDOUT,
                start_new_session=True,
            )
        except OSError:
            return None

        # Wait for the sink to register with the daemon before using it.
        for _ in range(40):
            if proc.poll() is not None:
                return None
            names = [s.get("name") for s in run_json(
                ["pactl", "-f", "json", "list", "sinks"])]
            if node in names:
                self.pid, self.node = proc.pid, node
                return node
            time.sleep(0.1)

        proc.terminate()
        return None

    def kill(self, pid: int | None = None) -> None:
        target = pid if pid is not None else self.pid
        if target is not None:
            self._kill_pid(target)
        if pid is None or pid == self.pid:
            self.pid, self.node = None, ""


def move_streams(to_sink: str, from_sinks: set[str]) -> int:
    """Move live streams sitting on from_sinks onto to_sink. Returns count."""
    sinks = {s["index"]: s["name"] for s in
             run_json(["pactl", "-f", "json", "list", "sinks"])
             if "index" in s and "name" in s}
    moved = 0
    for si in run_json(["pactl", "-f", "json", "list", "sink-inputs"]):
        idx, cur = si.get("index"), si.get("sink")
        if idx is None:
            continue
        if sinks.get(cur) in from_sinks:
            r = subprocess.run(["pactl", "move-sink-input", str(idx), to_sink],
                               capture_output=True)
            if r.returncode == 0:
                moved += 1
    return moved


def conf_targets(node: str) -> list[str]:
    """The outputs a running combine sink was built from, read back from the
    config we wrote for it. Authoritative even across app restarts."""
    try:
        with open(f"{RUNTIME}/multiout-{node}.conf") as fh:
            txt = fh.read()
    except OSError:
        return []
    return [n for n in re.findall(r'node\.name\s*=\s*"([^"]+)"', txt)
            if n != node]


def fallback_sink(sinks: list[Sink]) -> str:
    """Where audio should land when the outputs in use have all gone away."""
    for kind in ("wired", "hdmi"):
        for s in sinks:
            if s.kind == kind:
                return s.name
    return ""


def activate(combine: CombineManager, targets: list[str], old_default: str,
             compensate: bool) -> str | None:
    """Point audio at `targets`, building a combine sink when there's more than
    one. Live streams move across before the previous sink is torn down, so
    playback never gaps and no Bluetooth link is dropped.

    Returns the destination sink name, or None if the combine sink failed.
    """
    old_pid, old_node = combine.pid, combine.node

    if len(targets) == 1:
        dest = targets[0]
    else:
        dest = combine.spawn(targets, compensate)
        if dest is None:
            return None

    sources = set(targets) | ({old_default} if old_default else set())
    if old_node:
        sources.add(old_node)
    move_streams(dest, sources)
    subprocess.run(["pactl", "set-default-sink", dest], capture_output=True)

    # Tear the previous host down only after audio has moved across.
    if old_pid is not None and old_pid != combine.pid:
        combine.kill(old_pid)
    if len(targets) == 1 and old_pid is not None and old_pid == combine.pid:
        combine.kill()

    save_state(selected=sorted(targets))
    return dest


# ---------------------------------------------------------------- auto-switch

class AutoSwitch:
    """Follows Bluetooth sinks appearing and disappearing.

    Edge-triggered on purpose: it acts on a device *arriving* or *leaving*, not
    on it merely being present, so it never fights a choice made by hand.
    """

    def __init__(self, combine: CombineManager) -> None:
        self.combine = combine
        self.known: set[str] = set()
        self.primed = False

    @staticmethod
    def _bt(inv: Inventory) -> set[str]:
        return {s.name for s in inv.sinks if s.kind == "bluetooth"}

    def prime(self, inv: Inventory) -> None:
        """Record what is connected without reacting to it."""
        self.known = self._bt(inv)
        self.primed = True

    def reconcile(self, inv: Inventory, compensate: bool) -> str:
        """Act on any change since the last look. Returns a status line, or ""
        when there was nothing to do."""
        current = self._bt(inv)
        if not self.primed:
            self.prime(inv)
            return ""
        arrived = sorted(current - self.known)
        departed = self.known - current
        self.known = current

        if arrived:
            return self._on_connect(arrived, inv, compensate)
        if departed:
            return self._on_disconnect(departed, inv, compensate)
        return ""

    # -- transitions --------------------------------------------------------
    def _live(self, inv: Inventory) -> set[str]:
        return {s.name for s in inv.sinks if s.kind != "virtual"}

    def _on_connect(self, arrived: list[str], inv: Inventory,
                    compensate: bool) -> str:
        self.combine.adopt()
        node = self.combine.node
        if node:
            # A multi-output setup is running: the new device joins it rather
            # than silently replacing routing that was set up deliberately.
            keep = set(conf_targets(node)) & self._live(inv)
            targets = sorted(keep | set(arrived))
            verb = "added to the combined output"
        else:
            targets = arrived[:1]
            verb = "now playing here"

        dest = activate(self.combine, targets, inv.default_sink, compensate)
        if dest is None:
            return "auto-switch: PipeWire refused to build the combined sink"
        label = self._label(inv, arrived[0])
        return f"{label} connected — {verb}."

    def _on_disconnect(self, departed: set[str], inv: Inventory,
                       compensate: bool) -> str:
        self.combine.adopt()
        node = self.combine.node
        if node:
            remaining = sorted(set(conf_targets(node)) & self._live(inv))
        elif inv.default_sink in departed or inv.default_sink not in self._live(inv):
            remaining = []
        else:
            # PipeWire beat us to the fallback and the default is already
            # valid. Nothing to route, but drop the device that left so the
            # tick list doesn't keep a ghost entry.
            keep = sorted(set(load_state().get("selected", [])) - departed)
            save_state(selected=keep)
            return ""

        if not remaining:
            fb = fallback_sink(inv.sinks)
            if not fb:
                return ""
            remaining = [fb]

        dest = activate(self.combine, remaining, inv.default_sink, compensate)
        if dest is None:
            return ""
        if len(remaining) == 1:
            back = next((s.description for s in inv.sinks
                         if s.name == remaining[0]), remaining[0])
        else:
            back = f"the {len(remaining)} remaining outputs"
        return f"Bluetooth disconnected — audio moved back to {back}."

    @staticmethod
    def _label(inv: Inventory, sink_name: str) -> str:
        return next((s.description for s in inv.sinks if s.name == sink_name),
                    "Bluetooth device")


# ---------------------------------------------------------------- event watcher

class PactlWatcher(QThread):
    """Emits when PipeWire's sink topology changes (device connect/disconnect)."""
    changed = pyqtSignal()

    def __init__(self) -> None:
        super().__init__()
        self._stop = False
        self.proc: subprocess.Popen | None = None

    def run(self) -> None:
        try:
            self.proc = subprocess.Popen(
                ["pactl", "subscribe"], stdout=subprocess.PIPE, text=True,
                stderr=subprocess.DEVNULL,
            )
        except OSError:
            return
        assert self.proc.stdout
        for line in self.proc.stdout:
            if self._stop:
                return
            if "on sink " in line or "on card " in line or "on server" in line:
                self.changed.emit()

    def stop(self) -> None:
        self._stop = True
        if self.proc and self.proc.poll() is None:
            self.proc.terminate()


# ---------------------------------------------------------------- UI pieces

ICONS = {"bluetooth": "ᵇ", "wired": "♫", "hdmi": "▣", "virtual": "⬡"}
BADGE = {"bluetooth": "Bluetooth", "wired": "Wired", "hdmi": "HDMI", "virtual": "Virtual"}


class SinkRow(QFrame):
    toggled = pyqtSignal()
    volume_changed = pyqtSignal(str, int)

    def __init__(self, sink: Sink, checked: bool) -> None:
        super().__init__()
        self.sink = sink
        self.setObjectName("row")
        lay = QVBoxLayout(self)
        lay.setContentsMargins(12, 9, 12, 9)
        lay.setSpacing(6)

        top = QHBoxLayout()
        top.setSpacing(10)
        self.check = QCheckBox()
        self.check.setChecked(checked)
        self.check.stateChanged.connect(lambda _: self.toggled.emit())
        top.addWidget(self.check)

        title = QLabel(sink.description)
        f = title.font()
        f.setPointSizeF(f.pointSizeF() + 0.5)
        f.setWeight(QFont.Weight.DemiBold)
        title.setFont(f)
        top.addWidget(title)

        badge = QLabel(BADGE.get(sink.kind, sink.kind))
        badge.setObjectName("badge")
        badge.setProperty("kind", sink.kind)
        top.addWidget(badge)

        if sink.battery is not None:
            batt = QLabel(f"{sink.battery}%")
            batt.setObjectName("dim")
            top.addWidget(batt)

        top.addStretch(1)
        lay.addLayout(top)

        vol = QHBoxLayout()
        vol.setSpacing(8)
        vol.addSpacing(26)
        self.slider = QSlider(Qt.Orientation.Horizontal)
        self.slider.setRange(0, 150)
        self.slider.setValue(sink.volume)
        self.slider.setEnabled(not sink.muted)
        self.slider.valueChanged.connect(self._on_vol)
        self.vlabel = QLabel(f"{sink.volume}%")
        self.vlabel.setObjectName("dim")
        self.vlabel.setFixedWidth(42)
        vol.addWidget(self.slider, 1)
        vol.addWidget(self.vlabel)
        lay.addLayout(vol)

    def _on_vol(self, value: int) -> None:
        self.vlabel.setText(f"{value}%")
        self.volume_changed.emit(self.sink.name, value)


