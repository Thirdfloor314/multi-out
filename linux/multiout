#!/usr/bin/env python3
"""
Multi-Out — route audio to several outputs at once (Bluetooth, wired, HDMI).

Builds a PipeWire combine sink over whichever outputs you tick. Switching the
selection never disconnects a Bluetooth device and never stops playback: the
new sink is built and linked first, live streams are moved onto it, and only
then is the old one torn down.

Run with --daemon for the headless auto-switch service: it watches PipeWire and
points audio at a Bluetooth device the moment one connects, so you never have to
open this window to pick it.
"""
from __future__ import annotations

