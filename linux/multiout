        self.btn_apply.setDefault(True)
        self.btn_apply.clicked.connect(self.apply)
        btns.addWidget(self.btn_apply)
        fl.addLayout(btns)
        outer.addWidget(foot)

        self.setStyleSheet(STYLE)

        self.watcher = PactlWatcher()
        self.watcher.changed.connect(self._debounced_refresh)
        self.watcher.start()

        self._debounce = QTimer(self)
        self._debounce.setSingleShot(True)
        self._debounce.setInterval(400)
        self._debounce.timeout.connect(self.refresh)

        self.combine.adopt()
        if self.combine.node:
            self.status.setText("Adopted the routing already running.")
        self.refresh()

    # -- state --------------------------------------------------------------
    def _load_state(self) -> None:
        d = load_state()
        self.selected = set(d.get("selected", []))
        self.compensate = bool(d.get("compensate", False))
        self.autoswitch = bool(d.get("autoswitch", True))

    def _save_state(self) -> None:
        save_state(selected=sorted(self.selected),
                   compensate=self.compensate,
                   autoswitch=self.autoswitch)

    # -- refresh ------------------------------------------------------------
    def _debounced_refresh(self) -> None:
        if not self._applying:
            self._debounce.start()

    def refresh(self) -> None:
        self.inv = scan()
        while self.list.count() > 1:
            item = self.list.takeAt(0)
            w = item.widget()
            if w:
                w.deleteLater()

        # Virtual sinks (ours or another tool's combine sink) are excluded:
        # nesting one combine sink inside another loops audio back on itself.
        real = [s for s in self.inv.sinks if s.kind != "virtual"]
        for sink in real:
            row = SinkRow(sink, sink.name in self.selected)
            row.toggled.connect(self._on_toggle)
            row.volume_changed.connect(self._set_volume)
            self.list.insertWidget(self.list.count() - 1, row)

        for dev in self.inv.bt_offline:
            row = OfflineRow(dev)
            row.connect_requested.connect(self._connect_bt)
            self.list.insertWidget(self.list.count() - 1, row)

        # Drop selections whose device went away, so Apply stays honest.
        live = {s.name for s in real}
        self.selected &= live

        # With the service running it does the switching; doing it here too
        # would have two owners racing to set the default sink.
        if self.autoswitch and not self._applying and not daemon_running():
            self._applying = True
            try:
                msg = self.auto_engine.reconcile(self.inv, self.compensate)
            finally:
                self._applying = False
            if msg:
                self._load_state()
                self.status.setText(msg)
                QTimer.singleShot(400, self.refresh)
                return
        elif not self.autoswitch:
            self.auto_engine.prime(self.inv)

        self._update_status()

    def _on_toggle(self) -> None:
        self.selected = {
            r.sink.name
            for r in self.host.findChildren(SinkRow)
            if r.check.isChecked()
        }
        self._update_status()

    def _update_status(self) -> None:
        n = len(self.selected)
        active = self.combine.node or self.inv.default_sink
        if n == 0:
            msg = "No outputs ticked."
        elif n == 1:
            msg = "1 output ticked — audio routes to it directly."
        else:
            msg = f"{n} outputs ticked — they will share one combined sink."
        if self.combine.node:
            msg += "  Routing is active."
        elif active:
            msg += f"  Currently playing to: {active}"
        if self.autoswitch:
            msg += ("  Auto-switch on (service)." if daemon_running()
                    else "  Auto-switch on (only while this window is open).")
        self.status.setText(msg)
        self.btn_stop.setEnabled(bool(self.combine.node))

    # -- actions ------------------------------------------------------------
    def _on_auto(self) -> None:
        self.autoswitch = self.auto.isChecked()
        self._save_state()
        if self.autoswitch:
            self.auto_engine.prime(self.inv)
        self._update_status()

    def _on_comp(self) -> None:
        self.compensate = self.comp.isChecked()
        self._save_state()
        if self.combine.node:
            self.apply()

    def _set_volume(self, sink_name: str, value: int) -> None:
        subprocess.run(["pactl", "set-sink-volume", sink_name, f"{value}%"],
                       capture_output=True)

    def _connect_bt(self, mac: str) -> None:
        self.status.setText(f"Connecting {mac}…")
        QApplication.processEvents()
        subprocess.run(["bluetoothctl", "connect", mac], capture_output=True,
                       timeout=20)
        QTimer.singleShot(1500, self.refresh)

    def apply(self) -> None:
        targets = sorted(self.selected)
        if not targets:
            QMessageBox.information(self, "Nothing selected",
                                    "Tick at least one output first.")
            return

        self._applying = True
        self.btn_apply.setEnabled(False)
        try:
            if len(targets) > 1:
                self.status.setText("Building combined sink…")
                QApplication.processEvents()
            dest = activate(self.combine, targets, self.inv.default_sink,
                            self.compensate)
            if dest is None:
                QMessageBox.warning(
                    self, "Could not build combined sink",
                    "PipeWire refused to start the combine module.\n\n"
                    f"See {RUNTIME}/multiout-*.log for details.")
                return
            # This selection is now the baseline, so auto-switch treats only
            # later arrivals as new.
            self.auto_engine.prime(self.inv)
            self._save_state()
        finally:
            self._applying = False
            self.btn_apply.setEnabled(True)
        QTimer.singleShot(300, self.refresh)

    def _stop_routing(self) -> None:
        node = self.combine.node
        if not node:
            return
        fallback = next((s.name for s in self.inv.sinks
                         if s.kind in ("wired", "bluetooth")), "")
        if fallback:
            move_streams(fallback, {node})
            subprocess.run(["pactl", "set-default-sink", fallback],
                           capture_output=True)
        self.combine.kill()
        QTimer.singleShot(300, self.refresh)

    def _test_tone(self) -> None:
        wav = f"{RUNTIME}/multiout-tone.wav"
        if not os.path.exists(wav):
            import math
            import struct
            import wave
            rate, dur = 48000, 2.0
            w = wave.open(wav, "w")
            w.setnchannels(2)
            w.setsampwidth(2)
            w.setframerate(rate)
            frames = bytearray()
            for i in range(int(rate * dur)):
                t = i / rate
                f = 440 if int(t * 2) % 2 == 0 else 660
                env = min(1.0, t / 0.05, (dur - t) / 0.05)
                s = int(0.25 * env * 32767 * math.sin(2 * math.pi * f * t))
                frames += struct.pack("<hh", s, s)
            w.writeframes(bytes(frames))
            w.close()
        dest = self.combine.node or run(["pactl", "get-default-sink"]).strip()
        if dest:
            subprocess.Popen(["paplay", f"--device={dest}", wav])

    # -- teardown -----------------------------------------------------------
    def closeEvent(self, event) -> None:  # noqa: N802 (Qt naming)
        self.watcher.stop()
        self.watcher.wait(1500)
        # Leave routing running on purpose: closing the window should not cut
        # the audio the user just set up.
        event.accept()


